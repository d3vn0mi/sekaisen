# Normalise every text file to LF, on every platform.
* text=auto eol=lf

# The conformance logs are compared byte for byte.
*.jsonl  text eol=lf

# Binary files: never normalised, never diffed as text.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.sqlite binary
*.db     binary
*.gz     binary
*.tgz    binary
*.zip    binary
